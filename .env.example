# Copy this file to ".env" and fill in the values.
#   cp .env.example .env
#
# .env is gitignored — never commit real keys.

# ---------- server ----------
PORT=8080

# "production" on Render. Locally leave it unset or use "development".
# This also flips the auth cookie to secure + SameSite=None, which a
# deployed frontend on another domain needs.
NODE_ENV=development

# The ONE origin the API accepts requests from. Must match the frontend
# exactly, including the port. Wrong value = every call fails with a CORS
# error that looks like the server is down.
FRONTEND_URL=http://localhost:5173

# ---------- database ----------
# Local Postgres, or the connection string your host gives you.
DATABASE_URL=postgresql://localhost:5432/travel_buddy

# ---------- our own login ----------
# Any long random string. Changing it logs everybody out.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---------- Auth0 (social login) ----------
# AUTH0_AUDIENCE must match the frontend's VITE_AUTH0_AUDIENCE byte for byte,
# or login appears to work and then every API call returns 401.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://your-tenant.us.auth0.com/api/v2/
AUTH0_CLAIMS_NAMESPACE=https://mytravelbuddy.example.com/

# ---------- external APIs ----------
# Google Gemini. The server refuses to start without it.
MY_TRAVEL_BUDDY=your-gemini-api-key

# Optional. Defaults to gemini-3.1-flash-lite.
GEMINI_MODEL=gemini-3.1-flash-lite

# How many days of a trip to plan in one request. Longer trips still work —
# they get the first N days and the UI says so. Higher = slower:
# 7 days ~5.7s, 14 days ~7.6s, 20 days ~9.6s, 30 days ~15s. Defaults to 14.
MAX_ITINERARY_DAYS=14

# RapidAPI key for the visa-requirement API (the Documents tab).
VISA_API=your-rapidapi-key
